{
  "name": "dsh-niuma-harness-widget",
  "version": "1.0.0",
  "description": "A DSH sidebar widget: live earnings, countdown and goal progress, with the amount hideable.",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "widget",
    "salary",
    "countdown"
  ],
  "homepage": "https://github.com/augustineclark10145-star/dsh-niuma-harness-widget#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/augustineclark10145-star/dsh-niuma-harness-widget.git"
  },
  "bugs": {
    "url": "https://github.com/augustineclark10145-star/dsh-niuma-harness-widget/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
